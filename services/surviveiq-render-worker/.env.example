# Copy to .env for local development. Never commit the real .env file.

NODE_ENV=production

# Railway sets PORT automatically; 3000 is the local fallback.
PORT=3000

# Required. Bearer token every route except /health must present.
# Generate with: openssl rand -hex 32
RENDER_WORKER_TOKEN=replace-with-a-strong-random-secret

# Comma-separated list of exact hostnames /probe is allowed to fetch from.
ALLOWED_MEDIA_HOSTS=br-super-thunder-b1x77bfo.storage.c-5.eu-central-1.aws.neon.tech

# Hard timeout (ms) for the whole download+ffprobe cycle in /probe.
PROBE_TIMEOUT_MS=30000
